# Copy to .env for local development. Never commit the real .env file.
# Rotate all credentials previously pasted into chats/logs before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_NEW_LONG_RANDOM_PASSWORD
TEACHER_REGISTRATION_CODE=replace-with-a-random-invite-code-at-least-24-chars
AI_COURSE_MAX_AI_LESSONS=24
AI_MODE=SMART
AI_REMOTE_FALLBACK_ENABLED=false
AI_WORKER_INTERVAL_MS=12000
AI_WORKER_MAX_ATTEMPTS=5
CODE_EXECUTOR_TOKEN=replace-with-output-from-openssl-rand-hex-32
CODE_EXECUTOR_URL=
CODE_JUDGE0_URL=https://ce.judge0.com
CODE_RUNNER_ENABLED=true
CODE_RUNNER_EXECUTOR=judge0
CODE_RUNNER_TIMEOUT_MS=10000
CODE_RUNNER_CPU_SECONDS=2
CODE_RUNNER_MEMORY_KB=128000
EXECUTOR_HOST_WORK_ROOT=/opt/hanhtrinhmoi-code-executor/runtime-work
GEMINI_API_KEY=replace-with-rotated-gemini-api-key
GEMINI_AUDIO_MODEL=gemini-3.8-flash
GEMINI_COURSE_MAX_OUTPUT_TOKENS=24000
GEMINI_COURSE_REPAIR_MAX_OUTPUT_TOKENS=24000
GEMINI_DAILY_QUOTA_COOLDOWN_MS=86400000
GEMINI_FAILURE_COOLDOWN_MS=300000
GEMINI_FALLBACK_MODELS=gemini-3.1-pro-preview,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_IMAGE_FALLBACK_MODELS=gemini-3.1-flash-image
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_MAX_FALLBACK_MODELS=4
GEMINI_MIN_REQUEST_GAP_MS=8000
GEMINI_MODEL=gemini-3.8-flash
GEMINI_QUOTA_COOLDOWN_MS=600000
GEMINI_RETRY_BASE_MS=6000
GEMINI_RETRY_COUNT=1
GEMINI_SMART_MODEL=gemini-3.1-pro-preview
GEMINI_TIMEOUT_MS=420000
GEMINI_TTS_FALLBACK_MODELS=gemini-3.8-flash-tts
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
LOCAL_LLM_ALLOW_PRIVATE_HOST=false
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_ENABLED=false
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_LLM_TIMEOUT_MS=45000
# Replace with your real MongoDB Atlas connection string. Keep credentials outside source control.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
OPENAI_API_KEY=replace-with-rotated-openai-api-key
OPENAI_MODEL=gpt-5-mini
OTP_EMAIL_FROM="Hanh Trinh Moi <no-reply@ten-mien-cua-ban>"
PORT=10000
# Optional: set 1 on Render Web Services; blank auto-detects Render; use 0 only for direct local development.
TRUST_PROXY_HOPS=
RESEND_API_KEY=replace-with-rotated-resend-api-key
ROBUX_MAX_DAILY=100
ROBUX_MAX_OPEN_REQUESTS=2
ROBUX_MIN_REDEEM=10
ROBUX_POINTS_PER_ROBUX=100
ROBUX_REWARDS_ENABLED=true
SCHOOL_YEAR=2026-2027
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes

# V1 behavior
NODE_ENV=development
SESSION_MAX_AGE_MS=604800000
SURVEY_ALLOW_UPDATE=true

# V2 learning engine
LEARNING_UNLOCK_SCORE=70
LEARNING_CHECKPOINT_SCORE=70
