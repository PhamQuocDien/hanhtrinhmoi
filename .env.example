# =============================================================================
# CẤU HÌNH MÔI TRƯỜNG — Hành Tinh Mơ Ước
# Copy tệp này thành `.env` rồi điền giá trị thật. KHÔNG commit tệp `.env`.
# =============================================================================

# --- Cơ sở dữ liệu -----------------------------------------------------------
# Bắt buộc cho phần cần CSDL (tài khoản, câu hỏi, đề thi, tiến độ).
# Thiếu biến này: các API đó trả 503 thay vì treo.
MONGO_URI=mongodb://127.0.0.1:27017/hanhtrinh

# --- Phiên đăng nhập ---------------------------------------------------------
# Nên đặt chuỗi ngẫu nhiên dài (>= 32 ký tự):  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Nếu bỏ trống, khoá được sinh từ chuỗi phái sinh — mất phiên khi khởi động lại.
SESSION_SECRET=

# Thời gian sống của phiên (giờ). Mặc định: 24.
SESSION_MAX_AGE_HOURS=24

# --- Tài khoản quản trị ------------------------------------------------------
# KHÔNG có ADMIN_PASSWORD thì KHÔNG tạo tài khoản quản trị.
# Cần tối thiểu 8 ký tự. Không có mật khẩu mặc định trong hệ thống.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Máy chủ -----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Đặt "production" khi triển khai: bật cookie secure và ẩn dấu vết lỗi.
NODE_ENV=development

# --- Bảo mật -----------------------------------------------------------------
# Số vòng băm bcrypt (10–12). Cao hơn = an toàn hơn nhưng chậm hơn.
BCRYPT_ROUNDS=10
# Số lần đăng nhập / đăng ký tối đa trong 15 phút.
AUTH_RATE_LIMIT_MAX=30

# --- Nhập tệp Word -----------------------------------------------------------
# Kích thước tối đa (byte). Mặc định 8 MB.
UPLOAD_MAX_BYTES=8388608
# Số câu tối đa nhận từ một tài liệu. Mặc định 300.
UPLOAD_MAX_QUESTIONS=300

# --- Chấm điểm ---------------------------------------------------------------
# Điểm đạt (thang 10) cho bài kiểm tra.
EXAM_PASS_SCORE=5
# Số câu tối đa trong một đề ngẫu nhiên.
EXAM_MAX_QUESTIONS=30