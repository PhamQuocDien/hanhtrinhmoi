# Sao chép thành .env và điền giá trị thật. Không commit .env.
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/hanhtrinhmoi
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_PASSWORD=change-this-admin-password

# AI cloud: để trống nếu chưa cấu hình; ứng dụng phải có fallback nội bộ.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SMART_MODEL=gemini-3.1-pro-preview
GEMINI_AUDIO_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_FALLBACK_MODELS=gemini-3.1-pro-preview,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_TTS_FALLBACK_MODELS=gemini-3.8-flash-tts
GEMINI_IMAGE_FALLBACK_MODELS=gemini-3.1-flash-image
GEMINI_RETRY_COUNT=1
GEMINI_RETRY_BASE_MS=6000
GEMINI_FAILURE_COOLDOWN_MS=300000
GEMINI_QUOTA_COOLDOWN_MS=600000
GEMINI_MAX_FALLBACK_MODELS=4
GEMINI_MIN_REQUEST_GAP_MS=8000
GEMINI_TIMEOUT_MS=420000
AI_MODE=SMART
AI_REMOTE_FALLBACK_ENABLED=true
AI_WORKER_INTERVAL_MS=30000
AI_WORKER_MAX_ATTEMPTS=3
# Course Factory personal path creates every lesson with AI; set up to 72 if the provider quota permits.
AI_COURSE_MAX_AI_LESSONS=24
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# An toàn: không chạy mã học viên trong tiến trình web.
CODE_RUNNER_ENABLED=false
CODE_RUNNER_EXECUTOR=remote
CODE_EXECUTOR_URL=
CODE_EXECUTOR_TOKEN=
CODE_RUNNER_TIMEOUT_MS=12000

# Do not retry a model after a daily/free-tier quota is exhausted (24 hours by default).
GEMINI_DAILY_QUOTA_COOLDOWN_MS=86400000
GEMINI_COURSE_MAX_OUTPUT_TOKENS=24000
GEMINI_COURSE_REPAIR_MAX_OUTPUT_TOKENS=24000
